# Copy this file to ".env" in the same folder and fill it in.
# The .env file is ignored by git; never commit or share it.

# API key with read AND write access to the library below
ZOTERO_API_KEY=

# "group" for a group library, "user" for your personal library
ZOTERO_LIBRARY_TYPE=group

# Group ID (group library) or user ID (personal library); digits only
ZOTERO_LIBRARY_ID=
